# Canvas environment. Copy to `.env` in the repo root (never commit it).
# First time? Follow docs/LOCAL_SETUP.md step by step.
# The API refuses to boot with NODE_ENV=production if DATABASE_URL, WEB_URL,
# S3_ENDPOINT or GOOGLE_REDIRECT_URI still point at localhost, or the S3 keys
# are the local test defaults (see apps/api/src/env.ts). Redis on 127.0.0.1
# is fine in production — it runs on the same server.

# ── Database: Supabase Postgres ─────────────────────────────────────────────
# Supabase dashboard → your project (canvas-dev locally, canvas-prod on the
# server) → "Connect" (top bar) → "Session pooler" → copy the URI and put your
# database password in place of [YOUR-PASSWORD].
#   Use the SESSION pooler (port 5432). NEVER the Transaction pooler (port
#   6543): it breaks prepared statements and session features.
#   Free projects pause after 7 days without activity — unpause from the
#   dashboard if the app suddenly can't connect.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: verify Supabase's TLS certificate. Dashboard → Project Settings →
# Database → SSL Configuration → "Download certificate". Set this to the
# file's path (or paste the PEM contents). Unset = encrypted but unverified.
SUPABASE_CA_CERT=
# Max DB connections per process (default 5). The free tier's connection cap
# is low — ecosystem.config.cjs sets 5 for the API and 3 for the worker.
DB_POOL_MAX=

# ── Redis (BullMQ queues) ───────────────────────────────────────────────────
# Local Redis: in WSL on Windows (`sudo apt install redis-server`), apt on the
# production server. Same value in both places.
REDIS_URL=redis://127.0.0.1:6379

# ── File storage: Cloudflare R2 ─────────────────────────────────────────────
# Cloudflare dashboard → R2 Object Storage.
#   S3_ENDPOINT: R2 overview page → "Account Details" → S3 API
#     (https://<account-id>.r2.cloudflarestorage.com — without the bucket name).
#   S3_BUCKET: create it first (canvas-dev locally, canvas-prod on the server);
#     the app never creates R2 buckets itself. Add the CORS rule from
#     docs/LOCAL_SETUP.md under bucket → Settings → CORS Policy.
#   Keys: R2 overview → "Manage API tokens" → Create API token → permission
#     "Object Read & Write", scoped to that bucket → copy the Access Key ID and
#     Secret Access Key (shown once).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=canvas-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── App URLs ────────────────────────────────────────────────────────────────
API_PORT=3001
# Dev: the Vite dev server. Prod: the public https:// origin (the API serves
# the built web app itself, so this is the only public URL).
WEB_URL=http://localhost:5183


# Google OAuth (leave unset to disable "Continue with Google" — email/password still works)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Anthropic (Brain chat + vision understanding). Leave unset to use mocks —
# queue/worker/WS/persistence still run for real.
ANTHROPIC_API_KEY=

# Optional image-provider keys (adapters are mocked when unset; selection is
# per-workspace via Brand settings → Image engine).
OPENAI_API_KEY=
GEMINI_API_KEY=

# How often the worker checks for due recurring tasks + reminders (ms).
SCHEDULER_TICK_MS=60000

# SMTP for the email notifications digest. Leave SMTP_HOST unset to use a
# mock (logs instead of sending) — queue/worker/DB cursor still run for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Canvas <notifications@canvas.local>

# How often a user's unread notifications are batched into a digest email (ms).
DIGEST_INTERVAL_MS=86400000

# Optional error tracking (Sentry). Leave unset locally; paste real DSNs in prod.
# API + worker share SENTRY_DSN; the Vite app uses VITE_SENTRY_DSN (build-time).
SENTRY_DSN=
VITE_SENTRY_DSN=

# Max login/signup attempts per IP+email window before rate-limiting kicks in.
AUTH_RATE_LIMIT_MAX=20
AUTH_EMAIL_RATE_LIMIT_MAX=10

# Disables the SSRF guard on outbound Slack URLs — e2e tests only,
# refused at boot in production (see apps/api/src/env.ts).
SAFE_OUTBOUND_ALLOW_PRIVATE=false
