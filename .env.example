# Postgres
DATABASE_URL=postgres://canvas:canvas@localhost:5432/canvas

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible storage (RustFS locally — docker-compose.yml `s3` service)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=canvas-dev
S3_ACCESS_KEY_ID=canvas
S3_SECRET_ACCESS_KEY=canvas12345
S3_FORCE_PATH_STYLE=true

# apps/api
API_PORT=3001
WEB_URL=http://localhost:5183

# Production: set NODE_ENV=production and replace every localhost / MinIO
# default above with real managed Postgres (pgvector), Redis, S3/R2, and
# an HTTPS WEB_URL. The API refuses to boot in production if those
# still look like local/dev values (see apps/api/src/env.ts).

# Google OAuth (leave unset to disable "Continue with Google" — email/password still works)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Anthropic (Brain chat + vision understanding). Leave unset to use mocks —
# queue/worker/WS/persistence still run for real.
ANTHROPIC_API_KEY=

# Optional image-provider keys (adapters are mocked when unset; selection is
# per-workspace via Brand settings → Image engine).
OPENAI_API_KEY=
GEMINI_API_KEY=

# How often the worker checks for due recurring tasks + reminders (ms).
SCHEDULER_TICK_MS=60000

# SMTP for the email notifications digest. Leave SMTP_HOST unset to use a
# mock (logs instead of sending) — queue/worker/DB cursor still run for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Canvas <notifications@canvas.local>

# How often a user's unread notifications are batched into a digest email (ms).
DIGEST_INTERVAL_MS=86400000

# Optional error tracking (Sentry). Leave unset locally; paste real DSNs in prod.
# API + worker share SENTRY_DSN; the Vite app uses VITE_SENTRY_DSN (build-time).
SENTRY_DSN=
VITE_SENTRY_DSN=

# Max login/signup attempts per IP+email window before rate-limiting kicks in.
AUTH_RATE_LIMIT_MAX=20
AUTH_EMAIL_RATE_LIMIT_MAX=10

# Disables the SSRF guard on outbound Slack URLs — e2e tests only,
# refused at boot in production (see apps/api/src/env.ts).
SAFE_OUTBOUND_ALLOW_PRIVATE=false
